{
  "name": "@bendyline/squisq-formats",
  "version": "2.6.1",
  "description": "Document format converters — DOCX, PDF, OOXML import/export",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/squisq.git",
    "directory": "packages/formats"
  },
  "homepage": "https://github.com/bendyline/squisq",
  "keywords": [
    "docx",
    "pdf",
    "ooxml",
    "pptx",
    "xlsx",
    "epub",
    "document",
    "converter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./docx": {
      "types": "./dist/docx/index.d.ts",
      "import": "./dist/docx/index.js",
      "default": "./dist/docx/index.js"
    },
    "./pptx": {
      "types": "./dist/pptx/index.d.ts",
      "import": "./dist/pptx/index.js",
      "default": "./dist/pptx/index.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx/index.d.ts",
      "import": "./dist/xlsx/index.js",
      "default": "./dist/xlsx/index.js"
    },
    "./csv": {
      "types": "./dist/csv/index.d.ts",
      "import": "./dist/csv/index.js",
      "default": "./dist/csv/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./ooxml": {
      "types": "./dist/ooxml/index.d.ts",
      "import": "./dist/ooxml/index.js",
      "default": "./dist/ooxml/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.js",
      "default": "./dist/pdf/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js",
      "default": "./dist/html/index.js"
    },
    "./epub": {
      "types": "./dist/epub/index.d.ts",
      "import": "./dist/epub/index.js",
      "default": "./dist/epub/index.js"
    },
    "./container": {
      "types": "./dist/container/index.d.ts",
      "import": "./dist/container/index.js",
      "default": "./dist/container/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    },
    "./infer": {
      "types": "./dist/infer/index.d.ts",
      "import": "./dist/infer/index.js",
      "default": "./dist/infer/index.js"
    },
    "./outside-in": {
      "types": "./dist/outside-in/index.d.ts",
      "import": "./dist/outside-in/index.js",
      "default": "./dist/outside-in/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/generate-bundle-licenses.mjs . @fortawesome/fontawesome-free && node ../../scripts/remove-empty-chunks.mjs dist",
    "dev": "concurrently -n js,dts -c blue,gray -r \"tsup --watch --no-dts --no-clean\" \"tsup --watch --dts-only --no-clean\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bendyline/squisq": "2.11.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@pdf-lib/upng": "1.0.1",
    "@xmldom/xmldom": "0.9.12",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "peerDependencies": {
    "hyparquet": "^1.29.1"
  },
  "peerDependenciesMeta": {
    "hyparquet": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.2.0",
    "hyparquet": "1.29.1",
    "hyparquet-writer": "0.16.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
