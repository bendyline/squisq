{
  "name": "@bendyline/squisq-cli",
  "version": "2.3.0",
  "description": "Squisq CLI — convert documents and render MP4 video or animated GIF",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/squisq.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bendyline/squisq",
  "keywords": [
    "squisq",
    "markdown",
    "docx",
    "pdf",
    "html",
    "converter",
    "gif",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "squisq": "./dist/index.js"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/remove-empty-chunks.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "test:native": "mocha --grep \"flagship pptx|native animated GIF\""
  },
  "dependencies": {
    "@bendyline/squisq": "2.3.0",
    "@bendyline/squisq-formats": "2.3.0",
    "@bendyline/squisq-react": "2.3.0",
    "@bendyline/squisq-video": "2.2.0",
    "commander": "12.1.0",
    "playwright-core": "1.58.2"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "chai": "5.3.3",
    "mocha": "11.3.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
