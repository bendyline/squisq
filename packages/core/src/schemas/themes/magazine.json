{
  "schemaVersion": "1",
  "id": "magazine",
  "name": "Magazine",
  "description": "Rich editorial palette with mixed serif/sans typography and slide transitions.",
  "colors": {
    "primary": "#c53030",
    "secondary": "#2b6cb0",
    "background": "#1a202c",
    "backgroundLight": "#2d3748",
    "text": "#f7fafc",
    "textMuted": "#cbd5e0",
    "highlight": "#ed8936",
    "warning": "#fc8181"
  },
  "typography": {
    "bodyFont": {
      "stackId": "dm-sans"
    },
    "titleFont": {
      "stackId": "dm-serif"
    },
    "titleWeight": "bold",
    "titleScale": 1.05,
    "lineHeight": 1.5
  },
  "style": {
    "textShadow": true,
    "overlayOpacity": 0.45,
    "animationSpeed": 1.0,
    "borderRadius": 6
  },
  "renderStyle": {
    "name": "magazine",
    "defaultTextAnimation": "fadeIn",
    "defaultImageAnimation": "slowZoom",
    "ambientMotion": true,
    "defaultTransition": {
      "type": "slideLeft",
      "duration": 0.7
    }
  },
  "colorSchemes": {
    "blue": {
      "bg": "#1d3a6e",
      "text": "#a3c9f5",
      "accent": "#4d9de0"
    },
    "green": {
      "bg": "#14532d",
      "text": "#86efac",
      "accent": "#22c55e"
    },
    "purple": {
      "bg": "#3b2a70",
      "text": "#c4b5fd",
      "accent": "#a78bfa"
    },
    "red": {
      "bg": "#7f1d1d",
      "text": "#fca5a5",
      "accent": "#f87171"
    },
    "orange": {
      "bg": "#7c2d12",
      "text": "#fdba74",
      "accent": "#f97316"
    },
    "teal": {
      "bg": "#134e4a",
      "text": "#5eead4",
      "accent": "#14b8a6"
    }
  },
  "persistentLayers": {
    "topLayers": [
      {
        "template": "patternBackground",
        "config": {
          "type": "patternBackground",
          "pattern": "diagonal",
          "color": "#f7fafc",
          "opacity": 0.03,
          "scale": 1.2
        }
      }
    ]
  },
  "pageStyle": {
    "family": "editorial",
    "tokens": {
      "contentMaxWidth": 720,
      "wideMaxWidth": 1240,
      "sectionSpacing": "comfortable",
      "cornerRadius": 6,
      "divider": "double-rule",
      "backgroundRhythm": "flat",
      "heroStyle": "split",
      "headingTreatment": {
        "eyebrow": "kicker",
        "scale": "display",
        "underline": "none"
      },
      "imageFraming": "flush",
      "shadow": "none",
      "quoteMark": "oversized-glyph",
      "numeralStyle": "oversized",
      "pattern": "diagonal"
    },
    "sections": {
      "prose": {
        "hints": {
          "dropCap": true
        }
      },
      "feature-split": {
        "hints": {
          "alternate": true
        }
      }
    },
    "accentRotation": {
      "strategy": "alternate-two"
    }
  }
}
