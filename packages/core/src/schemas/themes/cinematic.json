{
  "schemaVersion": "1",
  "id": "cinematic",
  "name": "Cinematic",
  "description": "Ultra-dark with moody gradients, gold accents, and slow dissolve transitions.",
  "colors": {
    "primary": "#d69e2e",
    "secondary": "#b7791f",
    "background": "#0a0f1a",
    "backgroundLight": "#1a202c",
    "text": "#f7fafc",
    "textMuted": "#a0aec0",
    "highlight": "#ecc94b",
    "warning": "#fc8181"
  },
  "typography": {
    "bodyFont": { "stackId": "crimson" },
    "titleFont": { "stackId": "cormorant" },
    "titleWeight": "bold",
    "lineHeight": 1.5,
    "titleLineHeight": 1.2
  },
  "style": {
    "textShadow": true,
    "overlayOpacity": 0.55,
    "animationSpeed": 1.2
  },
  "renderStyle": {
    "name": "cinematic",
    "defaultTextAnimation": "fadeIn",
    "defaultImageAnimation": "slowZoom",
    "ambientMotion": true,
    "defaultTransition": { "type": "dissolve", "duration": 1.2 },
    "templateHints": {
      "title": { "showAccentLine": true }
    }
  },
  "colorSchemes": {
    "blue": { "bg": "#0f1d33", "text": "#9db8dc", "accent": "#5d84b8" },
    "green": { "bg": "#10251c", "text": "#9ecfae", "accent": "#55a878" },
    "purple": { "bg": "#1f1433", "text": "#c3aede", "accent": "#8f74c0" },
    "red": { "bg": "#2e1114", "text": "#e0959a", "accent": "#c05f66" },
    "orange": { "bg": "#2e1d0b", "text": "#e3b978", "accent": "#d69e2e" },
    "teal": { "bg": "#0d2626", "text": "#93cfc7", "accent": "#4d9e94" }
  },
  "persistentLayers": {
    "bottomLayers": [
      {
        "template": "gradientBackground",
        "config": { "type": "gradientBackground", "preset": "radial-dark" }
      }
    ]
  }
}
