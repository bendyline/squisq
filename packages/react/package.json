{
  "name": "@bendyline/squisq-react",
  "version": "2.4.4",
  "description": "React component library for doc playback, block rendering, and media layers",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/squisq.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/bendyline/squisq",
  "keywords": [
    "react",
    "doc-player",
    "block-renderer",
    "svg",
    "animation",
    "video"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    },
    "./page": {
      "types": "./dist/page/index.d.ts",
      "import": "./dist/page/index.js"
    },
    "./layers": {
      "types": "./dist/layers/index.d.ts",
      "import": "./dist/layers/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./json-view": {
      "types": "./dist/json-view/index.d.ts",
      "import": "./dist/json-view/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.css"
    },
    "./standalone": "./dist/squisq-player.global.js",
    "./standalone/full": "./dist/squisq-player.full.global.js",
    "./standalone-source": {
      "types": "./dist/standalone-source.d.ts",
      "import": "./dist/standalone-source.js"
    }
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.standalone.config.ts && node scripts/generate-standalone-source.mjs && node ../../scripts/build-styles.mjs && node ../../scripts/generate-bundle-licenses.mjs . && node ../../scripts/remove-empty-chunks.mjs dist",
    "build:esm": "tsup",
    "build:standalone": "tsup --config tsup.standalone.config.ts && node scripts/generate-standalone-source.mjs",
    "dev": "npm run build:standalone && concurrently -n js,dts -c blue,gray -r \"tsup --watch --no-dts --no-clean\" \"tsup --watch --dts-only --no-clean\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@bendyline/squisq": "2.4.3",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "preact": "10.29.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "25.0.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
