{
  "name": "@bendyline/squisq-video-react",
  "version": "2.2.10",
  "description": "React components for browser-based MP4 and animated-GIF export of Squisq documents",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/squisq.git",
    "directory": "packages/video-react"
  },
  "homepage": "https://github.com/bendyline/squisq",
  "keywords": [
    "squisq",
    "video",
    "mp4",
    "gif",
    "react",
    "webcodecs",
    "export"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./encoder": {
      "types": "./dist/encoder/index.d.ts",
      "import": "./dist/encoder/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.txt",
    "COPYING.GPL-2.0.txt"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/generate-bundle-licenses.mjs . && node ../../scripts/remove-empty-chunks.mjs dist",
    "dev": "concurrently -n js,dts -c blue,gray -r \"tsup --watch --no-dts --no-clean\" \"tsup --watch --dts-only --no-clean\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@bendyline/squisq": "2.4.4",
    "@bendyline/squisq-video": "2.2.8",
    "@bendyline/squisq-react": "2.4.6",
    "@ffmpeg/core": "0.12.9",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "html2canvas": "1.4.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "mp4-muxer": "5.2.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
