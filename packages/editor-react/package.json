{
  "name": "@bendyline/squisq-editor-react",
  "version": "2.2.0",
  "description": "React editor shell with raw/WYSIWYG/preview modes for Squisq documents",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/squisq.git",
    "directory": "packages/editor-react"
  },
  "homepage": "https://github.com/bendyline/squisq",
  "keywords": [
    "editor",
    "react",
    "markdown",
    "wysiwyg",
    "monaco",
    "tiptap"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./monaco": {
      "types": "./dist/monaco.d.ts",
      "import": "./dist/monaco.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./json-editor": {
      "types": "./dist/json-editor/index.d.ts",
      "import": "./dist/json-editor/index.js"
    },
    "./image-editor": {
      "types": "./dist/image-editor/index.d.ts",
      "import": "./dist/image-editor/index.js"
    },
    "./recorder": {
      "types": "./dist/recorder/index.d.ts",
      "import": "./dist/recorder/index.js"
    },
    "./teleprompter": {
      "types": "./dist/teleprompter/index.d.ts",
      "import": "./dist/teleprompter/index.js"
    },
    "./styles": "./dist/styles/index.css"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/build-styles.mjs && node ../../scripts/remove-empty-chunks.mjs dist",
    "dev": "concurrently -n js,dts -c blue,gray -r \"tsup --watch --no-dts --no-clean\" \"tsup --watch --dts-only --no-clean\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.50.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "dependencies": {
    "@bendyline/squisq": "2.2.0",
    "@bendyline/squisq-formats": "2.2.0",
    "@bendyline/squisq-react": "2.2.0",
    "@fortawesome/fontawesome-free": "7.2.0",
    "@tiptap/extension-image": "2.27.2",
    "@tiptap/extension-link": "2.27.2",
    "@tiptap/extension-mention": "2.27.2",
    "@tiptap/extension-placeholder": "2.27.2",
    "@tiptap/extension-table": "2.27.2",
    "@tiptap/extension-table-cell": "2.27.2",
    "@tiptap/extension-table-header": "2.27.2",
    "@tiptap/extension-table-row": "2.27.2",
    "@tiptap/extension-task-item": "2.27.2",
    "@tiptap/extension-task-list": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "@tiptap/suggestion": "2.27.2",
    "mermaid": "11.16.0",
    "type-fest": "4.41.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
