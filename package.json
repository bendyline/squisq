{
  "name": "squisq",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "install:safe": "npm install && node scripts/run-install-allowlist.mjs",
    "all": "npm run install:safe && npm run build && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:mutation && npm run test:published && npm run test:cli && npm run test:cli:native:required && npm run test:e2e:ci",
    "build": "npm run build:core && npm run build:formats && npm run build:react && npm run build:video && npm run build:video-react && npm run build:editor && npm run build:cli && npm run build:site",
    "build:core": "npm run build -w @bendyline/squisq",
    "build:formats": "npm run build -w @bendyline/squisq-formats",
    "build:react": "npm run build -w @bendyline/squisq-react",
    "build:video": "npm run build -w @bendyline/squisq-video",
    "build:video-react": "npm run build -w @bendyline/squisq-video-react",
    "build:editor": "npm run build -w @bendyline/squisq-editor-react",
    "build:cli": "npm run build -w @bendyline/squisq-cli",
    "build:site": "npm run build -w squisq-site",
    "build:dev": "npm run build:core && npm run build:formats && npm run build:react && npm run build:video && npm run build:video-react && npm run build:editor",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:mutation": "stryker run",
    "test:cli": "npm test -w @bendyline/squisq-cli",
    "test:cli:native": "npm run test:native -w @bendyline/squisq-cli",
    "test:cli:native:required": "node scripts/assert-native-video-tools.mjs && node scripts/run-required-native-cli-tests.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:built": "playwright test",
    "test:e2e:ci": "node scripts/run-ci-e2e-tests.mjs",
    "test:published": "vitest run --config vitest.published.config.ts",
    "screenshots:templates": "node scripts/generate-template-screenshots.mjs",
    "site": "npm run dev",
    "dev": "npm run build:dev && node scripts/run-dev.mjs",
    "dev:site": "npm run dev -w squisq-site",
    "dev:packages": "npm run build && concurrently -n core,formats,react,video,video-react,editor -c blue,cyan,magenta,yellow,green,red \"npm:dev:packages:core\" \"npm:dev:packages:formats\" \"npm:dev:packages:react\" \"npm:dev:packages:video\" \"npm:dev:packages:video-react\" \"npm:dev:packages:editor\"",
    "dev:packages:core": "npm run dev -w @bendyline/squisq",
    "dev:packages:formats": "npm run dev -w @bendyline/squisq-formats",
    "dev:packages:react": "npm run dev -w @bendyline/squisq-react",
    "dev:packages:video": "npm run dev -w @bendyline/squisq-video",
    "dev:packages:video-react": "npm run dev -w @bendyline/squisq-video-react",
    "dev:packages:editor": "npm run dev -w @bendyline/squisq-editor-react",
    "squisq": "node packages/cli/dist/index.js",
    "typecheck": "tsc -b packages/core packages/formats packages/react packages/video packages/video-react packages/editor-react packages/cli packages/site",
    "clean": "rimraf packages/*/dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "prettierfix": "prettier --write .",
    "release": "multi-semantic-release"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@vitest/coverage-v8": "4.1.7",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "concurrently": "10.0.3",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-sonarjs": "4.0.2",
    "globals": "15.15.0",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "multi-semantic-release": "3.1.0",
    "mocha": "11.3.0",
    "prettier": "3.8.1",
    "rimraf": "5.0.10",
    "semantic-release": "25.0.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.1.4",
    "vitest": "4.1.7"
  },
  "overrides": {
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "serialize-javascript": "7.0.5",
    "npm": "11.16.0"
  }
}
