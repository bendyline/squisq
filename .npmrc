# Pin every dependency version (no ^ or ~ ranges) when adding new deps via
# `npm install <pkg>`. Peer dependencies remain explicit ranges in package.json.
save-exact=true

# Don't auto-update workspace package versions on `npm install`.
workspaces-update=false

# Refuse to run any third-party install / preinstall / postinstall scripts on
# `npm install`. Supply-chain hardening: an attacker who compromises a transitive
# dep cannot ship a malicious postinstall and have it execute on developer
# machines or CI runners.
#
# A small, explicit allowlist of packages whose install scripts ARE required
# (currently just `esbuild` to download its native binary) lives in
# `scripts/run-install-allowlist.mjs`. The canonical install command is:
#
#     npm run install:safe
#
# which runs `npm install` (no scripts) and then explicitly invokes the
# allowlist runner. See CLAUDE.md "Installing dependencies" for details.
ignore-scripts=true

# Hold third-party releases for seven days at install time: the window that
# scripts/check-dependency-age.mjs enforces in CI (dependency-cooldown.yml),
# and the cooldown DocBlocks applies to everything Squisq publishes. Without it
# a local `npm install` or `npm update` can adopt an hours-old release that only
# the CI gate would catch later. Our own `@bendyline/*` packages are never held.
# Needs npm 11.17 or newer; an older npm (Node 22's bundled npm in CI) ignores
# it, and the CI gate still applies there.
min-release-age=7
min-release-age-exclude[]=@bendyline/*
